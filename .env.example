# Telegram API (получить на https://my.telegram.org → API development tools)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Двухфакторная аутентификация (облачный пароль). 
# Заполните это поле, чтобы бот автоматически входил без запроса пароля в консоли.
TG_PASSWORD=your_cloud_password_here

# Google Gemini API Key (получить на https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Твоё имя
MY_NAME=

# Какой ИИ-движок использовать? (gemini / local / groq)
#   gemini — Облачный Gemini от Google (быстро и удобно)
#   groq   — Облачный сверхбыстрый Groq (бесплатно до 14 400 запросов в день)
#   local  — Локальный ИИ на вашем ПК через Ollama
AI_ENGINE=gemini

# API-ключ для Groq (получить бесплатно на https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Модель для Groq (llama-3.3-70b-versatile — мега-умная и быстрая, llama-3.1-8b-instant — супер-легкая)
GROQ_MODEL=llama-3.3-70b-versatile

# URL локального API (по умолчанию для Ollama: http://localhost:11434/v1, для LM Studio: http://localhost:1234/v1)
LOCAL_AI_BASE_URL=http://localhost:11434/v1

# Название модели в Ollama / LM Studio (например: llama3.2:1b, gemma2:2b)
LOCAL_AI_MODEL=llama3.2:1b

# Режим моментального ответа (True — отвечать моментально, False — симулировать поведение человека с задержками и опечатками)
INSTANT_REPLY=True

